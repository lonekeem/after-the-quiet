{
  "appId": "com.lonekeemstudios.app",
  "appName": "After the Quiet",
  "webDir": "dist",
  "backgroundColor": "#050b08",
  "android": {
    "backgroundColor": "#050b08",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#050b08",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#050b08",
      "style": "DARK",
      "overlaysWebView": false
    }
  }
}